# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID администратора (владельца бота). Узнать свой ID можно у @userinfobot
ADMIN_ID=123456789

# Telegram-чат/канал, куда бот публикует уведомления о новых и отменённых записях.
# Используется ТОЛЬКО для информирования — никакой обязательной подписки для клиентов нет.
# Бот должен быть добавлен в этот чат/канал как администратор с правом отправки сообщений.
# Может быть @username канала или числовой ID (-100...). Оставьте пустым, чтобы отключить.
SCHEDULE_CHANNEL_ID=

# --- Информация о СТО ---
STO_NAME=Автосервис "Пример"
STO_ADDRESS=г. Москва, ул. Примерная, д. 1
STO_PHONE=+79999999999
STO_WORKING_HOURS=ПН-ПТ 09:00-19:00, СБ 09:00-18:00, ВС 09:00-17:00

# Ссылка на WhatsApp (формат https://wa.me/79999999999). Оставьте пустым, чтобы скрыть кнопку.
WHATSAPP_URL=https://wa.me/79999999999

# Ссылка на Telegram-аккаунт/чат СТО. Оставьте пустым, чтобы скрыть кнопку "Telegram".
TELEGRAM_URL=https://t.me/example

# Путь к файлу базы данных SQLite (можно оставить по умолчанию)
DB_PATH=data/sto_bot.db
